MODE=mqtt
USE_TLS=false

# Network Simulation (adds artificial latency and jitter)
ENABLE_NETWORK_SIMULATION=true
# Network latency range in milliseconds (min-max)
NETWORK_LATENCY_MIN_MS=5
NETWORK_LATENCY_MAX_MS=50
# Processing delay range in milliseconds (simulates hardware processing)
PROCESSING_DELAY_MIN_MS=1
PROCESSING_DELAY_MAX_MS=10

# Payload Size Configuration (in bytes)
# Each message will have a random size between min and max
PAYLOAD_SIZE_MIN_BYTES=100
PAYLOAD_SIZE_MAX_BYTES=1000